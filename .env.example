# Session / cookies
SESSION_SECRET=replace-with-a-long-random-secret
SECRET_ENCRYPTION_KEY=replace-with-32-byte-base64-or-hex-key
ALLOWED_ORIGIN=https://portal.example.com
# Session cookies are marked Secure by default; set to false only for plain-HTTP local dev.
COOKIE_SECURE=true
TRUST_PROXY=1

# Optional break-glass override for self-signed / legacy upstreams.
# Leave false unless you explicitly need to bypass Proxmox/FortiGate TLS verification temporarily.
ALLOW_INSECURE_UPSTREAM_TLS=false

# First-run bootstrap admin
# Leave these blank on existing installs unless you are intentionally bootstrapping
# a new empty database.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-this-before-first-start

# Frontend bind address for docker-compose
FRONTEND_BIND_ADDRESS=127.0.0.1
