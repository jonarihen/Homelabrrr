# PostgreSQL — the postgres service reads these; the backend's DATABASE_URL is
# assembled from them in docker-compose.yml (override DATABASE_URL directly to
# point at an external database instead).
POSTGRES_DB=homelabrrr
POSTGRES_USER=homelabrrr
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# Override to use an external PostgreSQL instead of the bundled service:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
PG_POOL_SIZE=10
# On the first boot of an empty database, a legacy db.sqlite left on the
# db_data volume is imported automatically (keep the same SECRET_ENCRYPTION_KEY).
# Set to false to skip it and import by hand — see "Migrating from SQLite".
# AUTO_IMPORT_SQLITE=false

# Session / cookies
SESSION_SECRET=replace-with-a-long-random-secret
SECRET_ENCRYPTION_KEY=replace-with-32-byte-base64-or-hex-key
# Stable identifier embedded in new ciphertext. Change it when rotating the key.
SECRET_ENCRYPTION_KEY_ID=primary
# Old key ids and values used only for decrypting/rotating existing records.
# JSON example: {"old-2025":"<old-32-byte-key>"}
SECRET_ENCRYPTION_PREVIOUS_KEYS=
ALLOWED_ORIGIN=https://portal.example.com
# Passkey relying-party settings. Defaults to ALLOWED_ORIGIN's hostname/origin.
WEBAUTHN_RP_ID=portal.example.com
WEBAUTHN_ORIGIN=https://portal.example.com
WEBAUTHN_RP_NAME=Homelabrrr
# Session cookies are marked Secure by default; set to false only for plain-HTTP local dev.
COOKIE_SECURE=true
# Number of proxy hops in front of the backend. The bundled frontend nginx is
# always one hop; an external reverse proxy (Caddy/NPM) is a second — so the
# recommended setup needs 2 or the audit log records the proxy's IP instead of
# the client's. Set to 1 only if clients reach port 8181 directly.
TRUST_PROXY=2

# Optional break-glass override for self-signed / legacy upstreams.
# Leave false unless you explicitly need to bypass Proxmox/FortiGate TLS verification temporarily.
ALLOW_INSECURE_UPSTREAM_TLS=false

# Cloud-image download URLs that resolve to internal/reserved addresses are
# rejected (SSRF hardening). Set to true if you host images on an internal mirror.
ALLOW_INTERNAL_IMAGE_URLS=false

# Discord webhook notifications
# Absolute base URL of the portal, used to build "open in portal" links inside
# Discord embeds. Falls back to ALLOWED_ORIGIN when unset; links are omitted if
# neither is set.
PORTAL_BASE_URL=https://portal.example.com
# How often (ms) to poll Proxmox host/node health for unreachable/recovered
# notifications. Set to 0 to disable the background health monitor.
NODE_HEALTH_POLL_MS=60000

# Background timers
# How often (ms) the VM lease sweeper looks for expired leases and gracefully
# stops those VMs. Values below 60000 are raised to 60000.
LEASE_CHECK_INTERVAL_MS=900000
# How long (ms) a scheduled graceful shutdown waits for the guest before the
# hard-stop fallback fires. Raise it for slow-shutting-down guests.
VM_SCHEDULE_SHUTDOWN_TIMEOUT_MS=120000
# How often (ms) published websites are re-checked: routes a `caddy reload`
# dropped from the admin API are re-pushed, and every published site is re-probed
# over HTTPS so breakage surfaces without a user reporting it. Floored at 60000.
WEBSITE_RECONCILE_INTERVAL_MS=300000

# Retention and encrypted SQLite backups
AUDIT_RETENTION_DAYS=365
JOB_RETENTION_DAYS=90
# Leave the key empty to disable scheduled backups. Store it separately from
# the backup destination and SECRET_ENCRYPTION_KEY.
BACKUP_DIR=/app/backups
BACKUP_OFFSITE_DIR=/app/backups-offsite
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_MS=86400000
# Bind this to off-host or separately replicated storage in production.
BACKUP_HOST_PATH=./backups
# In production, point this at a separately mounted NAS/object-sync directory.
BACKUP_OFFSITE_HOST_PATH=./backups-offsite

# First-run bootstrap admin
# Leave these blank on existing installs unless you are intentionally bootstrapping
# a new empty database.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-this-to-at-least-12-characters

# Frontend bind address for docker-compose
FRONTEND_BIND_ADDRESS=127.0.0.1
