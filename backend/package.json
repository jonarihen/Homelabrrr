{
  "name": "proxmox-frontend-backend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.db.json",
    "typecheck:all": "tsc --noEmit",
    "test": "node --test",
    "restore-backup": "node src/scripts/restoreBackup.ts",
    "import-sqlite": "node src/scripts/importSqlite.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.17.3",
    "otplib": "^13.4.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.3",
    "ssh2": "^1.16.0",
    "uuid": "^14.0.1",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/ssh2": "^1.15.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.0",
    "better-sqlite3": "^13.0.2",
    "better-sqlite3-session-store": "^0.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "supertest": "^7.1.4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
